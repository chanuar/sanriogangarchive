---
import data from '../content/site.json';
import Doodle from '../components/Doodle.astro';
import '../styles/site.css';
import '@fontsource/unifrakturcook/700.css';
import '@fontsource/anton/latin-400.css';
import '@fontsource/caveat/latin-400.css';
const release = data.featuredRelease;
const photo = (id: string) => data.media.find(m => m.id === id)!;
const spotify = release.spotifyUrl as string | null;
const match = spotify?.match(/^https:\/\/open\.spotify\.com\/(?:intl-[a-z]+\/)?(album|track|artist|playlist|episode|show)\/([a-zA-Z0-9]+)(?:\?.*)?$/);
const spotifyEmbed = match ? `https://open.spotify.com/embed/${match[1]}/${match[2]}` : null;
const gangPhotos = ['photo-cat-selfie', 'photo-pink-signs', 'photo-2', 'photo-0', 'photo-1'];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="El archivo de SanrioGang: trap under, música, imágenes y fragmentos del grupo." />
    <meta name="theme-color" content="#050406" />
    <meta property="og:title" content="SanrioGang Archive — música, lore y fragmentos" />
    <meta property="og:description" content="Trap under, música, imágenes y fragmentos del grupo." />
    <meta property="og:image" content="/assets/logo-sanriogang.webp" />
    <title>SanrioGang Archive — música, lore y fragmentos</title>
    <link rel="icon" href="/assets/logo-sanriogang.webp" type="image/webp" />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <a class="wordmark" href="#home">SANRIOGANG ARCHIVE<span> &gt;&gt; cute // cursed // trap lore</span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">MENÚ +</button>
      <nav id="navigation" aria-label="Navegación principal">
        {data.site.navigation.map(item => <a href={item.href}>{item.label}</a>)}
        <a href="#links">LINKS ↗</a>
      </nav>
      <button class="effects-toggle" aria-pressed="false">EFECTOS: OFF</button>
    </header>
    <main id="main">
      <section id="home" class="hero" aria-labelledby="hero-title">
        <div class="hero-wings" aria-hidden="true"><Doodle kind="wings" /></div>
        <div class="hero-side" aria-hidden="true"><span class="hand">{data.editorial.heroNote}</span><Doodle kind="cat" /><span class="side-code">♡ MUSIC<br/>× ARCHIVE<br/>♡ FRIENDS<br/>× CHAOS<br/>♡ FOREVER</span></div>
        <div class="hero-core">
          <h1 id="hero-title"><span class="sr-only">SanrioGang Archive</span><img class="hero-logo" src={data.hero.logo} width="828" height="658" alt="" fetchpriority="high" /><span class="archive-word" aria-hidden="true">ARCHIVE</span></h1>
          <p class="paper hero-tagline">{data.hero.tagline.text}</p>
          <p class="hero-description">{data.hero.description.text}</p>
          <div class="hero-actions"><a class="button hot" href="#music">ESCUCHAR / LISTEN NOW <span>↗</span></a><a class="text-link" href="#archive">ABRIR EL ARCHIVO ↓</a></div>
        </div>
        <div class="hero-collage">
          <div class="live-fragment" aria-hidden="true"><img src="/assets/photo-2.webp" width="1200" height="800" alt="" /><span>REC ● &nbsp; SIGNAL FOUND</span></div>
          <p class="hand hero-scribble" aria-hidden="true">SAME KIDS<br/>DIFFERENT<br/>HELL… ♡</p>
          <figure class="snapshot hero-signs"><img src={photo('photo-pink-signs').src} alt={photo('photo-pink-signs').alt} width="960" height="1280" /><figcaption>sin_contexto.jpg</figcaption></figure>
          <figure class="snapshot hero-selfie"><img src={photo('photo-cat-selfie').src} alt={photo('photo-cat-selfie').alt} width="720" height="1280" /><figcaption>STILL HERE ♡</figcaption></figure>
          <span class="hero-star" aria-hidden="true">☆</span><span class="barcode" aria-hidden="true">SANRIOGANG.EXE</span>
        </div>
        <div class="hero-bottom"><span>✶ {data.editorial.together}</span><span class="demo-label">COPY EN REVISIÓN / DEMO</span><a href="#music">SCROLL TO ENTER ↓</a></div>
      </section>
      <section id="music" class="release section-shell" aria-labelledby="release-title">
        <div class="release-heading"><div><p class="eyebrow">LATEST RELEASE // <span>PENDIENTE DE CONFIRMAR</span></p><h2 id="release-title">{release.displayTitle}</h2></div><p class="hand" aria-hidden="true">más tristes<br/>más lindos<br/>más reales ♡</p></div>
        <div class="release-grid">
          <figure class="release-art"><img src={release.preview.poster} width="640" height="360" alt="Fotograma del clip Mimosas v3: dos personas junto a un banco al aire libre." loading="lazy" /><span class="art-cross" aria-hidden="true">✝</span><figcaption><strong class="hand">Mimosas v3</strong><span>FOTOGRAMA / NO ES PORTADA OFICIAL</span></figcaption></figure>
          <div class="music-panel">
            <div class="panel-top"><span>♫ AUDIO ARCHIVE</span><span>♡</span></div>
            {spotifyEmbed ? <><iframe src={spotifyEmbed} title="Escuchar el lanzamiento en Spotify" height="352" loading="lazy" allow="encrypted-media; fullscreen; picture-in-picture" /><a class="text-link" href={spotify!} target="_blank" rel="noopener noreferrer">Abrir en Spotify ↗</a></> : <div class="spotify-pending"><span class="spotify-symbol" aria-hidden="true">≋</span><div><strong>Spotify / señal pendiente</strong><p>El enlace oficial todavía no está confirmado.</p></div></div>}
            <p class="eyebrow songs-label">MIENTRAS TANTO, EN YOUTUBE ↙</p>
            <ol class="song-list">{data.songs.map((song, i) => <li><a href={song.url} target="_blank" rel="noopener noreferrer"><span class="song-index">0{i+1}.</span><span>{song.title || song.label}<small>{song.title ? 'YOUTUBE' : 'TÍTULO POR CONFIRMAR'}</small></span><span class="song-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
          </div>
          <div class="video-column">
            <button class="video-preview" data-dialog="media-mimosas-preview" aria-label="Abrir fragmento real Mimosas v3, 4,08 segundos"><img src={release.preview.poster} width="640" height="360" alt="" loading="lazy" /><span class="play-icon" aria-hidden="true">▶</span><span class="video-caption">VER FRAGMENTO <span>00:04,08</span></span></button>
            <p class="preview-note">CLIP REAL · 4,08 s<br/>Título provisional. Último lanzamiento sin confirmar.</p>
            <div class="filmstrip" aria-hidden="true"><img src="/assets/video/mimosas-v3-still-01.webp" width="640" height="360" alt="" loading="lazy"/><img src="/assets/video/mimosas-v3-still-02.webp" width="640" height="360" alt="" loading="lazy"/><span class="hand">same pain<br/>different party ♡</span></div>
            <a class="button youtube" href={data.site.links.youtube} target="_blank" rel="noopener noreferrer">▶ YOUTUBE / TODOS LOS VÍDEOS ↗</a>
          </div>
        </div>
      </section>
      <section id="archive" class="archive-section section-shell" aria-labelledby="archive-title">
        <div class="archive-main"><h2 id="archive-title">The Archive</h2><p class="eyebrow pink">MEMORIES, DEMOS, LORE & MORE… <span class="demo-label">DEMO</span></p>
          <div class="folder-window"><div class="window-bar"><span>sanriogang / lost+found</span><span aria-hidden="true">− □ ×</span></div><div class="folders">{data.archiveCollections.map((collection, i) => <button class={`folder folder-${i}`} data-dialog={`collection-${collection.id}`}><span class="folder-icon" aria-hidden="true"></span><strong>{collection.label}</strong><small>{data.lore.filter(entry => entry.collectionId === collection.id).length} entradas demo</small></button>)}</div></div>
        </div>
        <aside class="paper archive-note"><span class="tape" aria-hidden="true"></span><h3 class="hand">notas:</h3><ul>{data.editorial.archiveNote.map(note => <li>{note}</li>)}</ul><p class="hand">p.d.: la ternura también<br/>puede ser violenta.</p><span class="demo-label">NOTA PROPUESTA / DEMO</span><Doodle kind="cat" /></aside>
      </section>
      <section id="members" class="members section-shell" aria-labelledby="members-title">
        <div class="section-heading"><div><h2 id="members-title">The Gang</h2><p class="eyebrow pink">DIFFERENT SOULS, SAME HELL. <span class="demo-label">COPY DEMO</span></p></div><p class="hand">{data.editorial.gangNote} ♡</p></div>
        <div class="gang-collage">{gangPhotos.map((id,i) => {const media=photo(id); return <button class={`snapshot gang-photo gang-photo-${i}`} data-dialog={`media-${id}`}><span class="tape" aria-hidden="true"></span><img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy"/><span class="photo-label hand">archivo_00{i+1}<small>foto del archivo ↗</small></span></button>;})}</div>
        <p class="members-pending">[ FICHAS EN PREPARACIÓN ] <span>{data.membersPendingMessage}</span></p>
        {data.members.length > 0 && <div class="member-profiles">{(data.members as {id:string;name:string;role?:string;bio?:string;photo?:string}[]).map(member => <article><h3>{member.name}</h3>{member.photo && <img src={member.photo} alt={member.name} loading="lazy"/>}{member.role && <p>{member.role}</p>}{member.bio && <p>{member.bio}</p>}</article>)}</div>}
      </section>
      <section id="fragments" class="fragments section-shell" aria-labelledby="fragments-title">
        <div class="section-heading"><div><h2 id="fragments-title">Media // Fragments</h2><p class="eyebrow">STILLS, MOMENTS, CHAOS…</p></div><div class="gallery-controls"><span class="hand">life feels better<br/>in low res…</span><button data-gallery-step="-1" aria-label="Ver fragmentos anteriores">←</button><button data-gallery-step="1" aria-label="Ver más fragmentos">→</button></div></div>
        <div class="fragment-strip" tabindex="0" aria-label="Galería de fragmentos, desplazamiento horizontal">{data.media.map(media => <button class="fragment" data-dialog={`media-${media.id}`} aria-label={`Abrir: ${media.alt}`}><img src={media.type === 'video' ? media.poster : media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy"/><span>{media.type === 'video' ? '▶ FRAGMENTO / 4,08 s' : `${media.id}.webp`} ↗</span></button>)}</div>
      </section>
    </main>
    <footer id="links" class="site-footer section-shell">
      <a class="footer-logo" href="#home" aria-label="SanrioGang Archive, volver al inicio"><img src={data.hero.logo} width="828" height="658" alt="" loading="lazy"/><span class="hand">archive</span></a>
      <div class="footer-links"><a href={data.site.links.youtube} target="_blank" rel="noopener noreferrer"><b aria-hidden="true">▶</b>YOUTUBE<small>vídeos / entrar ↗</small></a>{data.site.links.spotify ? <a href={data.site.links.spotify}>SPOTIFY ↗</a> : <div class="pending-link"><b aria-hidden="true">≋</b>SPOTIFY<small>enlace pendiente</small></div>}{data.site.links.instagram && <a href={data.site.links.instagram}>INSTAGRAM ↗</a>}{data.site.links.contactEmail && <a href={`mailto:${data.site.links.contactEmail}`}>CONTACTO ↗</a>}<a href="#archive"><b aria-hidden="true">♡</b>THE ARCHIVE<small>abrir carpetas ↑</small></a></div>
      <p class="hand footer-note">thank you<br/>for being part<br/>of this chaos ♡</p>
      <div class="footer-bottom"><span>{data.editorial.footer}</span><span class="demo-label">VERSIÓN DE REVISIÓN · COPY DEMO</span><a href="#home">STILL HERE. ↑</a></div>
    </footer>
    {data.archiveCollections.map(collection => <dialog id={`collection-${collection.id}`} aria-labelledby={`title-${collection.id}`} class="lore-dialog"><div class="dialog-bar"><span>ARCHIVE / {collection.label}</span><button data-close aria-label="Cerrar carpeta">CERRAR ×</button></div><div class="dialog-content"><p class="demo-label">CONTENIDO PROPUESTO / DEMO</p><h2 id={`title-${collection.id}`}>{collection.label}</h2>{data.lore.filter(entry => entry.collectionId === collection.id).length ? data.lore.filter(entry => entry.collectionId === collection.id).map(entry => <article class="lore-entry"><h3>{entry.title}</h3><p class="hand">{entry.body}</p>{entry.mediaIds.map(id => {const media=photo(id); return <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy"/>;})}</article>) : <p>Esta carpeta todavía está vacía. Los archivos llegarán cuando haya contenido confirmado.</p>}</div></dialog>)}
    {data.media.map(media => <dialog id={`media-${media.id}`} class="media-dialog" aria-label={media.alt}><div class="dialog-bar"><span>{media.type === 'video' ? 'FRAGMENTO REAL / 4,08 s' : media.id}</span><button data-close aria-label="Cerrar imagen o vídeo">CERRAR ×</button></div>{media.type === 'video' ? <><video controls playsinline preload="none" poster={media.poster} width={media.width} height={media.height}><source src={media.audioVersion} type="video/mp4" />Tu navegador no puede reproducir este vídeo.</video><a class="text-link" href={media.audioVersion}>Abrir el fragmento MP4 ↗</a></> : <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy"/>}<p class="media-description">{media.alt}</p></dialog>)}
    <script src="../scripts/site.ts"></script>
  </body>
</html>
